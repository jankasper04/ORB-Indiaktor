// Combined Indicator: CM_EMA Trend Bars + No Wick Candlestick Identifier
// Original EMA Trend Bars by ChrisMoody on 11/1/2014 - Updated to v5

//@version=5
indicator(title="CM_EMA TrendBars + No Wick Identifier", shorttitle="CM_EMA TrendBars", overlay=true, max_lines_count=500, max_labels_count=500)

// ==========================================
// EMA TREND BARS SETTINGS
// ==========================================
grp_ema = "EMA TREND BARS"
ema1 = input.int(34, minval=1, maxval=300, title="EMA UpTrend", group=grp_ema)
shema = input.bool(true, title="Show EMA Trend is Based On?", group=grp_ema)

// Calculate EMA
usedEma = ta.ema(close, ema1)

// Determine trend direction
emaUpColor = hlc3 >= usedEma
emaDownColor = hlc3 < usedEma

// Color based on trend
col = hlc3 >= usedEma ? color.lime : hlc3 < usedEma ? color.red : color.white

// Color bars based on EMA trend
barcolor(emaUpColor ? color.lime : emaDownColor ? color.red : na)

// Plot EMA line
plot(shema and usedEma ? usedEma : na, title="EMA", style=plot.style_line, linewidth=3, color=col)

// ==========================================
// NO WICK CANDLESTICK IDENTIFIER SETTINGS
// ==========================================
grp_nowick = "NO WICK IDENTIFIER"
showNoWickSignals = input.bool(true, title="Show No Wick Signals", group=grp_nowick)
showCompensationLines = input.bool(true, title="Show Compensation Lines", group=grp_nowick)
showCompensationLabels = input.bool(true, title="Show Compensation Labels", group=grp_nowick)
compensationColor = input.color(color.rgb(255, 174, 53), title="Compensation Color", group=grp_nowick)
lineLength = input.int(10, title="Line Length (bars)", minval=1, group=grp_nowick)

// Function to check for bullish candles with no bottom wick
bullishNoBottomWick = open == low and close > open

// Function to check for bearish candles with no top wick
bearishNoTopWick = open == high and close < open

// Plot triangles below bullish candles with no bottom wick
plotshape(series=showNoWickSignals and bullishNoBottomWick, location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small, title="Bullish No Bottom Wick")

// Plot triangles above bearish candles with no top wick
plotshape(series=showNoWickSignals and bearishNoTopWick, location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small, title="Bearish No Top Wick")

// Draw lines from opening price to the right for candles with no wicks
if showCompensationLines and (bullishNoBottomWick or bearishNoTopWick)
    line.new(x1=bar_index, y1=open, x2=bar_index + lineLength, y2=open, color=compensationColor, width=1, style=line.style_solid)

// Add label to display "Compensation" next to the line
if showCompensationLabels and (bullishNoBottomWick or bearishNoTopWick)
    label.new(x=bar_index + lineLength + 1, y=open, text="Compensation", style=label.style_label_left, color=compensationColor, textcolor=color.black, size=size.small)

// ==========================================
// ALERTS
// ==========================================
alertcondition(bullishNoBottomWick, "Bullish No Bottom Wick", "Bullish candle with no bottom wick detected")
alertcondition(bearishNoTopWick, "Bearish No Top Wick", "Bearish candle with no top wick detected")
alertcondition(ta.crossover(hlc3, usedEma), "EMA Crossover Up", "Price crossed above EMA")
alertcondition(ta.crossunder(hlc3, usedEma), "EMA Crossover Down", "Price crossed below EMA")
