// Combined ORB Indicator - Merging LuxAlgo ORB & ICT Killzones
// Based on "Opening Range with Breakouts & Targets [LuxAlgo]" and "ICT Killzones & Pivots [TFO]"

//@version=6
indicator("ORB Combined - Opening Range & ICT Killzones", shorttitle = "ORB Combined", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

//=============================================================================
// HELPER FUNCTIONS
//=============================================================================

get_line_style(_style) =>
    switch _style
        "Solid" => line.style_solid
        "Dotted" => line.style_dotted
        "Dashed" => line.style_dashed
        => line.style_solid

get_size(x) =>
    switch x
        "Auto" => size.auto
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        "Huge" => size.huge
        => size.normal

get_table_pos(pos) =>
    switch pos
        "Bottom Center" => position.bottom_center
        "Bottom Left" => position.bottom_left
        "Bottom Right" => position.bottom_right
        "Middle Center" => position.middle_center
        "Middle Left" => position.middle_left
        "Middle Right" => position.middle_right
        "Top Center" => position.top_center
        "Top Left" => position.top_left
        "Top Right" => position.top_right
        => position.top_right

fz(_val) => _val == 0 ? 1 : _val

get_1up(_val) => (_val - math.floor(_val)) > 0 ? int(math.floor(_val) + 1) : int(_val)

day_ma(_start, _type, s, l) =>
    bs_nd = fz(ta.barssince(_start))
    v_len = bs_nd < l ? bs_nd : l
    var float ma = na
    if _type == "EMA"
        k = 2 / (v_len + 1)
        ma := (s * k) + (nz(ma[1]) * (1 - k))
    if _type == "RMA"
        a = (1 / v_len)
        ma := a * s + (1 - a) * nz(ma[1])
    if _type == "SMA"
        ma := ta.sma(s, v_len)
    if _type == "WMA"
        ma := ta.wma(s, v_len)
    if _type == "VWMA"
        ma := ta.vwma(s, v_len)
    ma

