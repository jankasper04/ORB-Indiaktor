max_days = input.int(3, "Session Drawing Limit", 1, tooltip = "Maximum number of sessions to display", group = g_GENERAL)
tf_limit = input.timeframe("30", "Timeframe Limit", tooltip = "Drawings will not appear on timeframes greater than or equal to this", group = g_GENERAL)
showHist = input.bool(true, title = "Show Historical Data", group = g_GENERAL)
